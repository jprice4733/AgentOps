OPENAI_API_KEY=your_openai_api_key_here
S3_AUDIO_URI=s3://denverit-demo-bucket/voip-telecom-system/
S3_JSON_PREFIX=voip-telecom-system/json/
S3_CLIPS_PREFIX=voip-telecom-system/clips/
# Optional: use a named profile from your local AWS configuration.
# AWS_PROFILE=default
# AWS_DEFAULT_REGION=us-west-2

# Ingestion worker (python -m wav_search_agent.worker)
# CATALOG_PATH=storage/catalog.sqlite
# QDRANT_URL=http://localhost:6333      # server mode; omit to use a local path (single process only)
# QDRANT_API_KEY=
# QDRANT_PATH=storage/vectors
# WORKER_CONCURRENCY=4
# WORKER_MAX_ATTEMPTS=5
# WORKER_CREATE_CLIPS=false             # pre-build a full-recording WAV for every call (doubles storage)
